{
	"paths": {
		"downloads": "$HOME/Downloads",
		"archive_base": "$HOME/downloads_cleanup/data/archive",
		"log_dir": "$HOME/downloads_cleanup/data/logs",
		"cache_dir": "$HOME/downloads_cleanup/data/cache"
	},
	"routing": {
		"keyword_map": {
			"lecture": {
				"target": "$HOME/Documents/University",
				"scan": "filename"
			},
			"computer": {
				"target": "$HOME/Documents/University",
				"scan": "filename"
			},
			"lab": {
				"target": "$HOME/Documents/University/Assignments",
				"scan": "filename"
			},
			"csu": {
				"target": "$HOME/Documents/University/Assignments",
				"scan": "filename"
			},
			"assignment": {
				"target": "$HOME/Documents/University/Assignments",
				"scan": "filename"
			},
			"prac": {
				"target": "$HOME/Documents/University/Assignments",
				"scan": "filename"
			},
			"peer_tutoring": {
				"target": "$HOME/Documents/PeerTutoring",
				"scan": "filename"
			},
			"invoice": {
				"target": "$HOME/Documents/Finance",
				"scan": "filename"
			},
			"cv": {
				"target": "$HOME/Documents/Personal",
				"scan": "filename"
			},
			"img-": {
				"target": "$HOME/Pictures",
				"scan": "filename"
			}
		},
		"extension_map": {
			"php": "$HOME/Development",
			"py": "$HOME/Development",
			"js": "$HOME/Development",
			"pdf": "$HOME/Documents",
			"docx": "$HOME/Documents",
			"pptx": "$HOME/Documents",
			"xlsx": "$HOME/Documents",
			"zip": "$HOME/Programs",
			"rar": "$HOME/Programs",
			"deb": "$HOME/Programs",
			"mp4": "$HOME/Videos",
			"jpg": "$HOME/Pictures",
			"jpeg": "$HOME/Pictures",
			"png": "$HOME/Pictures"
		},
		"mime_map": {
			"image": "$HOME/Pictures",
			"video": "$HOME/Videos",
			"audio": "$HOME/Music",
			"application/pdf": "$HOME/Documents",
			"text": "$HOME/Documents"
		}
	},
	"archive": {
		"max_age_days": 14,
		"exclude_large_files_over_mb": 500
	},
	"logging": {
		"log_dir": "$HOME/downloads_cleanup/data/logs",
		"level": "debug",
		"jsonl_per_run": true
	},
	"notifications": {
		"email_enabled": true,
		"email_to": "mirukibs12.km@gmail.com",
		"email_from": "mirukibs12.km@gmail.com",
		"email_format": "html",
		"attach_log": true,
		"smtp": {
			"host": "smtp.gmail.com",
			"port": 587,
			"user": "$SMTP_USER",
			"pass": "$SMTP_PASS",
			"use_tls": true
		}
	}
}
